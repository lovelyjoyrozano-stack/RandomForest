WEATHER_CACHE_SECONDS=600


# Password reset email (SMTP). Example values only; never commit real credentials.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@example.com
EMAIL_USE_TLS=true
# Must point to your deployed/local Flutter Web app root; token is appended as query parameter.
PASSWORD_RESET_URL=http://localhost:5000/
PASSWORD_RESET_EXPIRE_MINUTES=30
